# Script-mode helper: reads INPUT_FILE, writes OUTPUT_FILE as a .cpp
# defining `extern "C" const unsigned char SYMBOL_NAME[]` +
# `SYMBOL_NAME_len`. Invoked via `cmake -P` from
# openfear_embed_binary_file() in OpenFearPlatform.cmake — no external
# tool (e.g. PS2SDK's bin2c) required, works on any host running CMake.
if(NOT DEFINED INPUT_FILE OR NOT DEFINED OUTPUT_FILE OR NOT DEFINED SYMBOL_NAME)
    message(FATAL_ERROR "EmbedBinaryFile.cmake requires -DINPUT_FILE=, -DOUTPUT_FILE=, -DSYMBOL_NAME=")
endif()

file(READ "${INPUT_FILE}" _hex HEX)
string(LENGTH "${_hex}" _hex_len)
math(EXPR _byte_count "${_hex_len} / 2")

# Comma-separated "0xNN" bytes, wrapped at a sane line length. Chunked
# regex replace is far faster than a per-byte foreach for files this size.
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes_all "${_hex}")
string(REGEX REPLACE "(0x..,){16}" "\\0\n    " _bytes_wrapped "${_bytes_all}")

file(WRITE "${OUTPUT_FILE}"
"// Auto-generated by EmbedBinaryFile.cmake from ${INPUT_FILE} — do not edit.
extern \"C\" const unsigned char ${SYMBOL_NAME}[] = {
    ${_bytes_wrapped}
};
extern \"C\" const unsigned long ${SYMBOL_NAME}_len = ${_byte_count}UL;
")
